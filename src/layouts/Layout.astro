---
import '../styles/global.css'
import Nav from '../components/Nav.astro'

interface Props {
  title?: string
}

const { title = 'Sayyad Hospital' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-slate-800">
    <Nav />
    <main>
      <slot />
    </main>
  </body>
</html>